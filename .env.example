# Copie para .env e preencha. O .env NUNCA vai para o Git.

# Token do bot — Developer Portal > sua aplicação > Bot > Reset Token
ZENIBOT_TOKEN=

# IDs dos donos do bot, separados por vírgula (comandos administrativos)
ZENIBOT_OWNER_IDS=

# Guild de desenvolvimento: slash commands sincronizados aqui propagam
# instantaneamente. Deixe vazio em produção para usar registro global.
ZENIBOT_DEV_GUILD_ID=

# Caminho do banco SQLite
ZENIBOT_DB_PATH=data/zenibot.db

# DEBUG | INFO | WARNING | ERROR
ZENIBOT_LOG_LEVEL=INFO

# Backup automático do banco. Os arquivos ficam em data/backups/,
# ao lado do banco (portanto dentro do volume, no Docker). 0 desativa.
ZENIBOT_BACKUP_INTERVAL_HOURS=24
ZENIBOT_BACKUP_KEEP=7

# Avisa no canal de alertas (ou no de logs) quando o bot sobe.
ZENIBOT_STARTUP_NOTICE=true
